DATABASE_URL="postgresql://techstore:techstore@localhost:5432/techstore?schema=public"
PORT=3000

# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

# Used by `npx prisma db seed` to create the first administrator
ADMIN_EMAIL="admin@techstore.local"
ADMIN_PASSWORD="change-me-admin-password"

# Orders: how long an unpaid online-card order / an unconfirmed order keeps its reservation
ORDER_PAYMENT_TTL_MINUTES=30
ORDER_CONFIRM_TTL_HOURS=24
ORDER_EXPIRY_CHECK_SECONDS=60

# Returns: days after delivery a customer may return goods just for changing their mind
RETURN_WINDOW_DAYS=14
