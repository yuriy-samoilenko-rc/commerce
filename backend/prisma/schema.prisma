// Этот файл описывает структуру базы данных.
// Prisma сама сгенерирует SQL-миграции и типобезопасный клиент из этого описания.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// В Prisma 7 строка подключения задаётся в prisma.config.ts, а не здесь.
datasource db {
  provider = "postgresql"
}

// --- Этап 1: пользователи и роли ---

enum Role {
  ADMIN
  MANAGER
  WAREHOUSE
  ACCOUNTANT
  CUSTOMER
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  name              String
  role              Role      @default(CUSTOMER)
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  // sessions issued before this moment are no longer accepted (set by password reset)
  passwordChangedAt DateTime?
  // покупатель: телефон и адрес доставки, которыми магазин заполняет заказ
  phone             String?
  deliveryAddress   String?
  // staff-only note on a customer ("calls after 17h", "wholesale buyer")
  staffNote         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  stockMovements      StockMovement[]
  receivingsCreated   Receiving[]          @relation("ReceivingCreatedBy")
  receivingsConfirmed Receiving[]          @relation("ReceivingConfirmedBy")
  transfersCreated    Transfer[]           @relation("TransferCreatedBy")
  transfersSent       Transfer[]           @relation("TransferSentBy")
  transfersReceived   Transfer[]           @relation("TransferReceivedBy")
  countsCreated       InventoryCount[]     @relation("CountCreatedBy")
  countsFinished      InventoryCount[]     @relation("CountFinishedBy")
  countsApproved      InventoryCount[]     @relation("CountApprovedBy")
  ordersPlaced        Order[]              @relation("OrderCustomer")
  ordersCreated       Order[]              @relation("OrderCreatedBy")
  orderEvents         OrderEvent[]
  returnsCreated      Return[]             @relation("ReturnCreatedBy")
  returnsReceived     Return[]             @relation("ReturnReceivedBy")
  returnsDecided      Return[]             @relation("ReturnDecidedBy")
  returnsRefunded     Return[]             @relation("ReturnRefundedBy")
  warrantyCases       WarrantyCase[]
  auditLogs           AuditLog[]
  documentsCreated    Document[]           @relation("DocumentCreatedBy")
  documentsReceived   Document[]           @relation("DocumentCustomer")
  reviews             Review[]             @relation("ReviewAuthor")
  reviewsModerated    Review[]             @relation("ReviewModerator")
  wishlist            WishlistItem[]
  passwordResets      PasswordResetToken[]
  questionsAsked      ProductQuestion[]    @relation("QuestionAuthor")
  questionsAnswered   ProductQuestion[]    @relation("QuestionAnswerer")
  notifications       Notification[]

  @@map("users")
}

// --- Этап 1: товары и категории ---

model Category {
  id       String     @id @default(uuid())
  name     String
  // for shop URLs: /katalog/televizori
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  @@map("brands")
}

model Product {
  id                String          @id @default(uuid())
  name              String
  // for shop URLs: /proizvod/samsung-galaxy-s24-256gb; stays when the name changes
  slug              String          @unique
  sku               String          @unique
  barcode           String?         @unique
  model             String?
  description       String?
  // Free-form specs that differ per category (screen size for TVs, volume for fridges...)
  attributes        Json            @default("{}")
  // true for goods tracked unit by unit (serial number / IMEI), see ТЗ п.4
  trackSerial       Boolean         @default(false)
  purchasePrice     Decimal         @db.Decimal(10, 2)
  sellingPrice      Decimal         @db.Decimal(10, 2)
  discountPrice     Decimal?        @db.Decimal(10, 2)
  // акция заканчивается в этот момент; null — без срока
  discountEndsAt    DateTime?
  // цена, по которой сейчас продаётся: discountPrice ?? sellingPrice (ведёт ProductsService)
  shopPrice         Decimal         @db.Decimal(10, 2)
  // по одобренным отзывам
  ratingAvg         Decimal?        @db.Decimal(3, 2)
  ratingCount       Int             @default(0)
  // стандартная ставка ПДВ в Черногории
  vatPercent        Decimal         @default(21) @db.Decimal(5, 2)
  weightKg          Decimal?        @db.Decimal(10, 3)
  warrantyMonths    Int?
  // порог "мало товара"; null — общий порог из настроек компании
  lowStockThreshold Int?
  // последний уровень, о котором уже уведомили: повторно уведомляем только при ухудшении
  stockAlert        StockAlertLevel @default(OK)
  isArchived        Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  stock            Stock[]
  movements        StockMovement[]
  serialUnits      SerialUnit[]
  receivingItems   ReceivingItem[]
  transferItems    TransferItem[]
  inventoryLines   InventoryLine[]
  inventorySerials InventorySerial[]
  orderItems       OrderItem[]
  reservations     StockReservation[]
  returnItems      ReturnItem[]
  images           ProductImage[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  stockAlerts      StockAlertSubscription[]
  questions        ProductQuestion[]

  @@index([categoryId])
  @@index([brandId])
  @@index([shopPrice])
  @@index([discountEndsAt])
  @@map("products")
}

// Фото товара для интернет-магазина. Файлы лежат в хранилище (см. MediaStorage) в двух
// размерах WebP; здесь только их ключ и порядок. position 0 — главное фото.
model ProductImage {
  id        String   @id @default(uuid())
  // путь без размера и расширения: products/<productId>/<imageId>
  fileKey   String   @unique
  width     Int
  height    Int
  // описание для незрячих и поисковиков ("Samsung 55" вид спереди")
  alt       String?
  position  Int
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

// --- Этап 2: склады, поставщики, остатки и журнал движений ---

model Warehouse {
  id            String   @id @default(uuid())
  name          String   @unique
  address       String?
  isActive      Boolean  @default(true)
  // покупатель может забрать заказ здесь (магазин показывает адрес, телефон и часы)
  isPickupPoint Boolean  @default(false)
  phone         String?
  openingHours  String?
  createdAt     DateTime @default(now())

  stock           Stock[]
  movements       StockMovement[]
  serialUnits     SerialUnit[]
  receivings      Receiving[]
  transfersFrom   Transfer[]         @relation("TransferFrom")
  transfersTo     Transfer[]         @relation("TransferTo")
  inventoryCounts InventoryCount[]
  reservations    StockReservation[]
  returns         Return[]
  warrantyCases   WarrantyCase[]
  documents       Document[]
  pickupOrders    Order[]            @relation("OrderPickupPoint")

  @@map("warehouses")
}

model Supplier {
  id             String    @id @default(uuid())
  name           String    @unique
  taxId          String?
  phone          String?
  email          String?
  address        String?
  contactPerson  String?
  notes          String?
  // bank account (žiro račun) and the purchase contract
  bankAccount    String?
  contractNumber String?
  contractUntil  DateTime? @db.Date
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  receivings Receiving[]
  documents  Document[]

  @@map("suppliers")
}

// Остаток товара на конкретном складе.
// quantity — физически на складе, reserved — зарезервировано под заказы.
// "Доступно" = quantity - reserved считается на уровне приложения, а не хранится отдельным полем,
// чтобы не рассинхронизироваться (см. п.27 ТЗ про журнал операций).
// Это кэш баланса: он меняется только в той же транзакции, что и запись в StockMovement.
// В миграции добавлены CHECK: quantity >= 0, reserved >= 0, reserved <= quantity.
model Stock {
  id        String   @id @default(uuid())
  quantity  Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("stock")
}

enum StockMovementType {
  RECEIPT
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  INVENTORY
  SALE
  RETURN
  WARRANTY_REPLACEMENT
}

// Журнал движений (п.27 ТЗ). Строки только добавляются: UPDATE и DELETE запрещены
// триггером в миграции, ошибка исправляется новой корректирующей записью.
model StockMovement {
  id           String            @id @default(uuid())
  type         StockMovementType
  // со знаком: +20 приход, -2 списание
  quantity     Int
  // остаток товара на этом складе сразу после движения — для истории вида "10 → 9"
  balanceAfter Int
  reason       String?
  createdAt    DateTime          @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // для товаров с поштучным учётом: одна строка журнала = один экземпляр
  serialUnitId String?
  serialUnit   SerialUnit? @relation(fields: [serialUnitId], references: [id])

  // документ-основание
  receivingId String?
  receiving   Receiving? @relation(fields: [receivingId], references: [id])

  transferId String?
  transfer   Transfer? @relation(fields: [transferId], references: [id])

  inventoryCountId String?
  inventoryCount   InventoryCount? @relation(fields: [inventoryCountId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  returnId String?
  return   Return? @relation(fields: [returnId], references: [id])

  warrantyCaseId String?
  warrantyCase   WarrantyCase? @relation(fields: [warrantyCaseId], references: [id])

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([serialUnitId])
  @@index([receivingId])
  @@index([transferId])
  @@index([inventoryCountId])
  @@index([returnId])
  @@index([warrantyCaseId])
  @@index([orderId])
  @@map("stock_movements")
}

enum SerialUnitStatus {
  IN_STOCK
  IN_TRANSIT
  WRITTEN_OFF
  SOLD
  // вернулся от клиента и ждёт проверки (в остатки не входит)
  RETURNED
  // у нас или в сервисе по гарантийному обращению
  IN_SERVICE
}

// Конкретный экземпляр товара с серийным номером (п.4, п.12 ТЗ).
model SerialUnit {
  id           String           @id @default(uuid())
  serialNumber String           @unique
  status       SerialUnitStatus @default(IN_STOCK)
  createdAt    DateTime         @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // null, когда экземпляр не на складе: в пути, списан, продан
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  // Закреплён за строкой заказа при сборке; после продажи ссылка остаётся как история.
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  // Дата продажи = начало гарантии (п.16 ТЗ)
  soldAt      DateTime?

  movements      StockMovement[]
  warrantyCases  WarrantyCase[]  @relation("WarrantyUnit")
  replacementFor WarrantyCase[]  @relation("WarrantyReplacement")

  @@index([productId, warehouseId, status])
  @@index([orderItemId])
  @@map("serial_units")
}

enum ReceivingStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// Приёмка товара от поставщика (п.6 ТЗ).
model Receiving {
  id     String          @id @default(uuid())
  // порядковый номер, наружу отдаётся как RCV-00001
  number Int             @unique @default(autoincrement())
  status ReceivingStatus @default(DRAFT)

  supplierDocNumber String?
  supplierDocDate   DateTime? @db.Date
  notes             String?

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  createdById String
  createdBy   User   @relation("ReceivingCreatedBy", fields: [createdById], references: [id])

  confirmedById String?
  confirmedBy   User?     @relation("ReceivingConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     ReceivingItem[]
  movements StockMovement[]
  documents Document[]

  @@index([status, createdAt])
  @@map("receivings")
}

model ReceivingItem {
  id            String   @id @default(uuid())
  quantity      Int
  purchasePrice Decimal  @db.Decimal(10, 2)
  // серийные номера вводятся в черновике, экземпляры создаются при подтверждении
  serialNumbers String[]

  receivingId String
  receiving   Receiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([receivingId])
  @@map("receiving_items")
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

// Перемещение между складами (п.7 ТЗ). Пока статус IN_TRANSIT, товар списан
// со склада-источника и ещё не зачислен на склад назначения — он "в пути".
model Transfer {
  id     String         @id @default(uuid())
  // наружу отдаётся как TR-00001
  number Int            @unique @default(autoincrement())
  status TransferStatus @default(DRAFT)
  notes  String?

  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])

  toWarehouseId String
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])

  createdById String
  createdBy   User   @relation("TransferCreatedBy", fields: [createdById], references: [id])

  sentById String?
  sentBy   User?     @relation("TransferSentBy", fields: [sentById], references: [id])
  sentAt   DateTime?

  receivedById String?
  receivedBy   User?     @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  receivedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     TransferItem[]
  movements StockMovement[]
  documents Document[]

  @@index([status, createdAt])
  @@index([toWarehouseId, status])
  @@map("transfers")
}

model TransferItem {
  id            String   @id @default(uuid())
  quantity      Int
  serialNumbers String[]

  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@map("transfer_items")
}

enum InventoryStatus {
  IN_PROGRESS
  COUNTED
  APPROVED
  CANCELLED
}

// Инвентаризация (п.14 ТЗ). Пока подсчёт открыт (IN_PROGRESS или COUNTED), движения
// по товарам в его области на этом складе запрещены: иначе продажа во время подсчёта
// выглядела бы как недостача. В миграции: не больше одной открытой инвентаризации на склад.
model InventoryCount {
  id     String          @id @default(uuid())
  // наружу отдаётся как CNT-00001
  number Int             @unique @default(autoincrement())
  status InventoryStatus @default(IN_PROGRESS)
  notes  String?

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  // Категория, выбранная при создании (null = весь склад), и все её подкатегории на тот момент.
  categoryId       String?
  scopeCategoryIds String[]

  createdById String
  createdBy   User   @relation("CountCreatedBy", fields: [createdById], references: [id])

  finishedById String?
  finishedBy   User?     @relation("CountFinishedBy", fields: [finishedById], references: [id])
  finishedAt   DateTime?

  approvedById String?
  approvedBy   User?     @relation("CountApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines     InventoryLine[]
  serials   InventorySerial[]
  movements StockMovement[]
  documents Document[]

  @@index([warehouseId, status])
  @@map("inventory_counts")
}

// Сколько единиц товара насчитали. expectedQuantity фиксируется при утверждении.
model InventoryLine {
  id               String   @id @default(uuid())
  countedQuantity  Int      @default(0)
  expectedQuantity Int?
  updatedAt        DateTime @updatedAt

  countId String
  count   InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([countId, productId])
  @@map("inventory_lines")
}

// Отсканированные серийные номера. Уникальность в пределах подсчёта защищает от
// двойного сканирования одного экземпляра с двух телефонов одновременно.
model InventorySerial {
  id           String   @id @default(uuid())
  serialNumber String
  scannedAt    DateTime @default(now())

  countId String
  count   InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([countId, serialNumber])
  @@index([countId, productId])
  @@map("inventory_serials")
}

// --- Этап 3: заказы и резервирование ---

enum OrderStatus {
  NEW
  CONFIRMED
  PICKING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  CARD_ONLINE
  CASH_ON_DELIVERY
  BANK_TRANSFER
}

enum DeliveryMethod {
  PICKUP
  COURIER
}

enum OrderChannel {
  ONLINE
  MANUAL
}

// Заказ (п.9, п.10 ТЗ). Контакты и адрес копируются в заказ: это данные на момент
// покупки, их не должно менять последующее редактирование профиля клиента.
model Order {
  id            String        @id @default(uuid())
  // номер для людей, начинается с 100001 (см. миграцию)
  number        Int           @unique @default(autoincrement())
  status        OrderStatus   @default(NEW)
  paymentStatus PaymentStatus @default(UNPAID)
  channel       OrderChannel

  paymentMethod   PaymentMethod
  deliveryMethod  DeliveryMethod
  customerName    String
  customerPhone   String
  customerEmail   String?
  deliveryAddress String?
  comment         String?

  subtotal      Decimal @db.Decimal(12, 2)
  // popust promo koda (već uračunat u cijene stavki i u subtotal)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  deliveryFee   Decimal @db.Decimal(10, 2)
  total         Decimal @db.Decimal(12, 2)

  // Когда резерв снимется автоматически, если заказ не оплатят / не подтвердят.
  // null — резерв бессрочный (оплачен, подтверждён или создан менеджером).
  reservationExpiresAt DateTime?
  cancelReason         String?
  paidAt               DateTime?

  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  completedAt    DateTime?

  userId String?
  user   User?   @relation("OrderCustomer", fields: [userId], references: [id])

  promoCodeId String?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])

  // при самовывозе: где покупатель заберёт заказ
  pickupWarehouseId String?
  pickupWarehouse   Warehouse? @relation("OrderPickupPoint", fields: [pickupWarehouseId], references: [id])

  createdById String?
  createdBy   User?   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     OrderItem[]
  events    OrderEvent[]
  movements StockMovement[]
  returns   Return[]
  documents Document[]

  @@index([status, reservationExpiresAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("orders")
}

// Название, SKU, цена и НДС фиксируются на момент заказа.
model OrderItem {
  id          String   @id @default(uuid())
  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  // cijena prije promo koda; null — bez promo popusta
  listPrice   Decimal? @db.Decimal(10, 2)
  vatPercent  Decimal  @db.Decimal(5, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  // себестоимость единицы на момент отгрузки (для прибыли); null — ещё не отгружено
  unitCost    Decimal? @db.Decimal(10, 2)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  serialUnits  SerialUnit[]
  reservations StockReservation[]
  returnItems  ReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Резерв конкретного количества на конкретном складе под строку заказа.
// Активен, пока releasedAt = null. stock.reserved = сумма активных резервов.
model StockReservation {
  id             String    @id @default(uuid())
  quantity       Int
  // сколько из зарезервированного уже собрано (отсканировано) на этом складе
  pickedQuantity Int       @default(0)
  createdAt      DateTime  @default(now())
  releasedAt     DateTime?
  releaseReason  String?

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([orderItemId])
  @@index([productId, warehouseId, releasedAt])
  @@map("stock_reservations")
}

enum OrderEventType {
  CREATED
  CONFIRMED
  PAID
  CANCELLED
  EXPIRED
  PICKING_STARTED
  PICKING_COMPLETED
  SHIPPED
  DELIVERED
  COMPLETED
  RETURN_APPROVED
}

// История заказа (order_status_history в п.26 ТЗ): что произошло, когда и кто это сделал.
model OrderEvent {
  id        String         @id @default(uuid())
  type      OrderEventType
  note      String?
  createdAt DateTime       @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // null — действие системы (например, автоотмена по таймеру)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_events")
}

// --- Возвраты и гарантия (п.15, п.16 ТЗ) ---

enum ReturnStatus {
  REQUESTED
  RECEIVED
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
}

enum ReturnReason {
  DEFECTIVE
  CHANGED_MIND
  DAMAGED
  WRONG_ITEM
  OTHER
}

enum ReturnDecision {
  // исправен → снова на складе
  RESTOCK
  // неисправен → списан
  SCRAP
  // возврат не принят → товар отдаётся клиенту
  REJECT
}

// Возврат RET-00001. До решения по строкам товар лежит в зоне возвратов и в остатки не входит.
model Return {
  id     String       @id @default(uuid())
  number Int          @unique @default(autoincrement())
  status ReturnStatus @default(REQUESTED)
  note   String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  // склад, куда товар физически вернули
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  refundAmount    Decimal? @db.Decimal(12, 2)
  refundReference String?

  createdById String
  createdBy   User   @relation("ReturnCreatedBy", fields: [createdById], references: [id])

  receivedById String?
  receivedBy   User?     @relation("ReturnReceivedBy", fields: [receivedById], references: [id])
  receivedAt   DateTime?

  decidedById String?
  decidedBy   User?     @relation("ReturnDecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?

  refundedById String?
  refundedBy   User?     @relation("ReturnRefundedBy", fields: [refundedById], references: [id])
  refundedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     ReturnItem[]
  movements StockMovement[]
  documents Document[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("returns")
}

model ReturnItem {
  id             String          @id @default(uuid())
  quantity       Int
  serialNumbers  String[]
  reason         ReturnReason
  reasonNote     String?
  decision       ReturnDecision?
  inspectionNote String?

  returnId String
  return   Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([orderItemId])
  @@map("return_items")
}

enum WarrantyStatus {
  OPEN
  RECEIVED
  IN_SERVICE
  REPAIRED
  CLOSED
  REPLACED
  REJECTED
}

// Гарантийное обращение WAR-00001 по конкретному экземпляру (п.16 ТЗ, экран 21 UI).
// В миграции: не больше одного открытого обращения на экземпляр.
model WarrantyCase {
  id     String         @id @default(uuid())
  number Int            @unique @default(autoincrement())
  status WarrantyStatus @default(OPEN)

  problem        String
  serviceCenter  String?
  resolutionNote String?

  serialUnitId String
  serialUnit   SerialUnit @relation("WarrantyUnit", fields: [serialUnitId], references: [id])

  // экземпляр, выданный взамен
  replacementUnitId String?
  replacementUnit   SerialUnit? @relation("WarrantyReplacement", fields: [replacementUnitId], references: [id])

  // склад, с которого выдана замена
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  receivedAt      DateTime?
  sentToServiceAt DateTime?
  repairedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  movements StockMovement[]

  @@index([serialUnitId])
  @@index([status, createdAt])
  @@map("warranty_cases")
}

// --- Журнал действий (п.22 ТЗ, экран Audit Log) ---

// Кто, когда и что сделал. Только добавление: UPDATE и DELETE запрещены триггером в миграции.
model AuditLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  // например "auth.login", "products.update", "orders.confirm"
  action     String
  entityType String?
  entityId   String?
  // HTTP-статус ответа: видно и неудачные попытки
  statusCode Int?
  // поля "было → стало": { "sellingPrice": { "from": "699", "to": "649" } }
  changes    Json?
  // маршрут и тело запроса без паролей и токенов
  details    Json?
  ip         String?
  userAgent  String?

  // null — действие системы или неизвестного пользователя
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// --- Документы (п.11 ТЗ, Этап 4) ---

// Реквизиты компании для документов (Settings → Company). Всегда одна строка с id = 1.
model CompanySettings {
  id                 Int      @id @default(1)
  name               String   @default("TechStore")
  legalName          String?
  address            String?
  taxId              String?
  registrationNumber String?
  bankAccount        String?
  phone              String?
  email              String?
  website            String?
  currency           String   @default("EUR")
  // НДС для доставки и прочих строк без товара
  defaultVatPercent  Decimal  @default(21) @db.Decimal(5, 2)
  // "мало товара", если доступно на активных складах не больше этого числа
  lowStockThreshold  Int      @default(2)
  // доставка курьером; бесплатно, если товаров в заказе на freeShippingFrom и больше
  courierFee         Decimal  @default(10) @db.Decimal(10, 2)
  freeShippingFrom   Decimal? @db.Decimal(10, 2)
  updatedAt          DateTime @updatedAt

  @@map("company_settings")
}

enum DocumentType {
  INVOICE
  DELIVERY_NOTE
  WARRANTY_CARD
  RECEIVING_NOTE
  TRANSFER_NOTE
  RETURN_NOTE
  INVENTORY_ACT
}

enum DocumentStatus {
  ISSUED
  CANCELLED
}

// Последний выданный номер по типу документа и году: INV-2026-000001, INV-2026-000002...
model DocumentCounter {
  type DocumentType
  year Int
  last Int          @default(0)

  @@id([type, year])
  @@map("document_counters")
}

// Выпущенный документ. data — полный неизменяемый снимок (реквизиты, стороны, строки, итоги),
// из него строится PDF. Исправление = аннулирование и новый документ, а не правка.
model Document {
  id       String         @id @default(uuid())
  type     DocumentType
  number   String         @unique
  year     Int
  seq      Int
  status   DocumentStatus @default(ISSUED)
  issuedAt DateTime       @default(now())

  cancelledAt  DateTime?
  cancelReason String?

  title            String
  counterpartyName String?
  total            Decimal? @db.Decimal(12, 2)
  currency         String
  data             Json

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  receivingId String?
  receiving   Receiving? @relation(fields: [receivingId], references: [id])

  transferId String?
  transfer   Transfer? @relation(fields: [transferId], references: [id])

  returnId String?
  return   Return? @relation(fields: [returnId], references: [id])

  inventoryCountId String?
  inventoryCount   InventoryCount? @relation(fields: [inventoryCountId], references: [id])

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  // покупатель с аккаунтом: может скачать свои документы
  customerId String?
  customer   User?   @relation("DocumentCustomer", fields: [customerId], references: [id])

  createdById String?
  createdBy   User?   @relation("DocumentCreatedBy", fields: [createdById], references: [id])

  @@unique([type, year, seq])
  @@index([type, issuedAt])
  @@index([issuedAt])
  @@index([orderId])
  @@index([receivingId])
  @@index([transferId])
  @@index([returnId])
  @@index([inventoryCountId])
  @@index([supplierId])
  @@index([customerId])
  @@map("documents")
}

// --- Уведомления и письма (п.20 ТЗ) ---

enum StockAlertLevel {
  OK
  LOW
  OUT
}

enum NotificationType {
  ORDER_NEW
  ORDER_PAID
  ORDER_TO_PICK
  ORDER_READY_TO_SHIP
  RECEIVING_CONFIRMED
  RETURN_REQUESTED
  STOCK_LOW
  STOCK_OUT
  WARRANTY_EXPIRING
}

// Уведомление сотруднику (колокольчик). entityType + entityId — куда ведёт клик.
model Notification {
  id         String           @id @default(uuid())
  type       NotificationType
  title      String
  body       String?
  entityType String?
  entityId   String?
  // защита от повторов: одно и то же событие не уведомляется дважды одному человеку
  dedupeKey  String?
  createdAt  DateTime         @default(now())
  readAt     DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

// Очередь писем (transactional outbox): письмо записывается в той же транзакции, что и
// событие, а отправляет его фоновый обработчик с повторами при ошибках.
model EmailOutbox {
  id          String      @id @default(uuid())
  to          String
  subject     String
  text        String
  html        String?
  // документы, которые прикладываются к письму как PDF
  documentIds String[]
  status      EmailStatus @default(PENDING)
  attempts    Int         @default(0)
  lastError   String?
  sendAfter   DateTime    @default(now())
  sentAt      DateTime?
  createdAt   DateTime    @default(now())

  orderId String?

  @@index([status, sendAfter])
  @@index([orderId])
  @@map("email_outbox")
}

// --- Отзывы и избранное интернет-магазина ---

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Отзыв может оставить только покупатель, получивший товар; виден после модерации.
model Review {
  id     String       @id @default(uuid())
  rating Int
  title  String?
  text   String
  status ReviewStatus @default(PENDING)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation("ReviewAuthor", fields: [userId], references: [id])

  moderatedAt   DateTime?
  moderatedById String?
  moderatedBy   User?     @relation("ReviewModerator", fields: [moderatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status, createdAt])
  @@map("reviews")
}

model WishlistItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@map("wishlist_items")
}

// Одноразовая ссылка «Zaboravljena lozinka»: хранится только хеш токена.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

// «Obavijesti me kada stigne»: email (gost ili kupac) čeka da proizvod opet bude dostupan.
// Red se briše čim se obavještenje pošalje.
model StockAlertSubscription {
  id        String   @id @default(uuid())
  email     String
  createdAt DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, email])
  @@index([createdAt])
  @@map("stock_alert_subscriptions")
}

// --- Promo kodovi ---

enum PromoType {
  PERCENT
  FIXED
}

// Kod za popust na korpu. Popust se raspoređuje na stavke narudžbe (OrderItem.listPrice
// čuva cijenu prije popusta), pa račun, PDV i povraćaj uvijek odgovaraju plaćenom.
model PromoCode {
  id               String    @id @default(uuid())
  code             String    @unique
  description      String?
  type             PromoType
  // procenat (1–100) ili iznos u eurima
  value            Decimal   @db.Decimal(10, 2)
  minSubtotal      Decimal?  @db.Decimal(10, 2)
  startsAt         DateTime?
  endsAt           DateTime?
  // null — bez ograničenja
  maxUses          Int?
  usedCount        Int       @default(0)
  onePerCustomer   Boolean   @default(true)
  excludeSaleItems Boolean   @default(true)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  orders Order[]

  @@map("promo_codes")
}

enum QuestionStatus {
  // čeka odgovor
  PENDING
  // odgovoreno i vidljivo na stranici proizvoda
  PUBLISHED
  // ne objavljuje se (spam, uvreda, lični podaci)
  HIDDEN
}

// «Pitanja i odgovori» na stranici proizvoda: pita prijavljeni kupac, odgovara prodavnica.
model ProductQuestion {
  id         String         @id @default(uuid())
  question   String
  answer     String?
  status     QuestionStatus @default(PENDING)
  answeredAt DateTime?
  createdAt  DateTime       @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("QuestionAuthor", fields: [userId], references: [id])

  answeredById String?
  answeredBy   User?   @relation("QuestionAnswerer", fields: [answeredById], references: [id])

  @@index([productId, status])
  @@index([status, createdAt])
  @@map("product_questions")
}

// --- Shop home page banners (the big slider) ---

enum BannerTheme {
  NAVY
  BLUE
  INK
  SKY
}

model Banner {
  id         String      @id @default(uuid())
  title      String
  text       String?
  // small label above the title, e.g. "AKCIJA"
  badge      String?
  buttonText String?
  // shop path (/katalog/televizori) or a full https:// address
  link       String
  theme      BannerTheme @default(NAVY)
  // media key of the picture (WebP), null = text only
  imageKey   String?
  position   Int         @default(0)
  isActive   Boolean     @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([isActive, position])
  @@map("banners")
}
