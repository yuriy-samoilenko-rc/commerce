// Этот файл описывает структуру базы данных.
// Prisma сама сгенерирует SQL-миграции и типобезопасный клиент из этого описания.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// В Prisma 7 строка подключения задаётся в prisma.config.ts, а не здесь.
datasource db {
  provider = "postgresql"
}

// --- Этап 1: пользователи и роли ---

enum Role {
  ADMIN
  MANAGER
  WAREHOUSE
  ACCOUNTANT
  CUSTOMER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements      StockMovement[]
  receivingsCreated   Receiving[]      @relation("ReceivingCreatedBy")
  receivingsConfirmed Receiving[]      @relation("ReceivingConfirmedBy")
  transfersCreated    Transfer[]       @relation("TransferCreatedBy")
  transfersSent       Transfer[]       @relation("TransferSentBy")
  transfersReceived   Transfer[]       @relation("TransferReceivedBy")
  countsCreated       InventoryCount[] @relation("CountCreatedBy")
  countsFinished      InventoryCount[] @relation("CountFinishedBy")
  countsApproved      InventoryCount[] @relation("CountApprovedBy")
  ordersPlaced        Order[]          @relation("OrderCustomer")
  ordersCreated       Order[]          @relation("OrderCreatedBy")
  orderEvents         OrderEvent[]

  @@map("users")
}

// --- Этап 1: товары и категории ---

model Category {
  id       String     @id @default(uuid())
  name     String
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  @@map("brands")
}

model Product {
  id             String   @id @default(uuid())
  name           String
  sku            String   @unique
  barcode        String?  @unique
  model          String?
  description    String?
  // Free-form specs that differ per category (screen size for TVs, volume for fridges...)
  attributes     Json     @default("{}")
  // true for goods tracked unit by unit (serial number / IMEI), see ТЗ п.4
  trackSerial    Boolean  @default(false)
  purchasePrice  Decimal  @db.Decimal(10, 2)
  sellingPrice   Decimal  @db.Decimal(10, 2)
  discountPrice  Decimal? @db.Decimal(10, 2)
  vatPercent     Decimal  @default(0) @db.Decimal(5, 2)
  weightKg       Decimal? @db.Decimal(10, 3)
  warrantyMonths Int?
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  stock            Stock[]
  movements        StockMovement[]
  serialUnits      SerialUnit[]
  receivingItems   ReceivingItem[]
  transferItems    TransferItem[]
  inventoryLines   InventoryLine[]
  inventorySerials InventorySerial[]
  orderItems       OrderItem[]
  reservations     StockReservation[]

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

// --- Этап 2: склады, поставщики, остатки и журнал движений ---

model Warehouse {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stock           Stock[]
  movements       StockMovement[]
  serialUnits     SerialUnit[]
  receivings      Receiving[]
  transfersFrom   Transfer[]         @relation("TransferFrom")
  transfersTo     Transfer[]         @relation("TransferTo")
  inventoryCounts InventoryCount[]
  reservations    StockReservation[]

  @@map("warehouses")
}

model Supplier {
  id            String   @id @default(uuid())
  name          String   @unique
  taxId         String?
  phone         String?
  email         String?
  address       String?
  contactPerson String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  receivings Receiving[]

  @@map("suppliers")
}

// Остаток товара на конкретном складе.
// quantity — физически на складе, reserved — зарезервировано под заказы.
// "Доступно" = quantity - reserved считается на уровне приложения, а не хранится отдельным полем,
// чтобы не рассинхронизироваться (см. п.27 ТЗ про журнал операций).
// Это кэш баланса: он меняется только в той же транзакции, что и запись в StockMovement.
// В миграции добавлены CHECK: quantity >= 0, reserved >= 0, reserved <= quantity.
model Stock {
  id        String   @id @default(uuid())
  quantity  Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("stock")
}

enum StockMovementType {
  RECEIPT
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  INVENTORY
  SALE
}

// Журнал движений (п.27 ТЗ). Строки только добавляются: UPDATE и DELETE запрещены
// триггером в миграции, ошибка исправляется новой корректирующей записью.
model StockMovement {
  id           String            @id @default(uuid())
  type         StockMovementType
  // со знаком: +20 приход, -2 списание
  quantity     Int
  // остаток товара на этом складе сразу после движения — для истории вида "10 → 9"
  balanceAfter Int
  reason       String?
  createdAt    DateTime          @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // для товаров с поштучным учётом: одна строка журнала = один экземпляр
  serialUnitId String?
  serialUnit   SerialUnit? @relation(fields: [serialUnitId], references: [id])

  // документ-основание
  receivingId String?
  receiving   Receiving? @relation(fields: [receivingId], references: [id])

  transferId String?
  transfer   Transfer? @relation(fields: [transferId], references: [id])

  inventoryCountId String?
  inventoryCount   InventoryCount? @relation(fields: [inventoryCountId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([serialUnitId])
  @@index([receivingId])
  @@index([transferId])
  @@index([inventoryCountId])
  @@index([orderId])
  @@map("stock_movements")
}

enum SerialUnitStatus {
  IN_STOCK
  IN_TRANSIT
  WRITTEN_OFF
  SOLD
}

// Конкретный экземпляр товара с серийным номером (п.4, п.12 ТЗ).
model SerialUnit {
  id           String           @id @default(uuid())
  serialNumber String           @unique
  status       SerialUnitStatus @default(IN_STOCK)
  createdAt    DateTime         @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // null, когда экземпляр не на складе: в пути, списан, продан
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  // Закреплён за строкой заказа при сборке; после продажи ссылка остаётся как история.
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  // Дата продажи = начало гарантии (п.16 ТЗ)
  soldAt      DateTime?

  movements StockMovement[]

  @@index([productId, warehouseId, status])
  @@index([orderItemId])
  @@map("serial_units")
}

enum ReceivingStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// Приёмка товара от поставщика (п.6 ТЗ).
model Receiving {
  id     String          @id @default(uuid())
  // порядковый номер, наружу отдаётся как RCV-00001
  number Int             @unique @default(autoincrement())
  status ReceivingStatus @default(DRAFT)

  supplierDocNumber String?
  supplierDocDate   DateTime? @db.Date
  notes             String?

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  createdById String
  createdBy   User   @relation("ReceivingCreatedBy", fields: [createdById], references: [id])

  confirmedById String?
  confirmedBy   User?     @relation("ReceivingConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     ReceivingItem[]
  movements StockMovement[]

  @@index([status, createdAt])
  @@map("receivings")
}

model ReceivingItem {
  id            String   @id @default(uuid())
  quantity      Int
  purchasePrice Decimal  @db.Decimal(10, 2)
  // серийные номера вводятся в черновике, экземпляры создаются при подтверждении
  serialNumbers String[]

  receivingId String
  receiving   Receiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([receivingId])
  @@map("receiving_items")
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

// Перемещение между складами (п.7 ТЗ). Пока статус IN_TRANSIT, товар списан
// со склада-источника и ещё не зачислен на склад назначения — он "в пути".
model Transfer {
  id     String         @id @default(uuid())
  // наружу отдаётся как TR-00001
  number Int            @unique @default(autoincrement())
  status TransferStatus @default(DRAFT)
  notes  String?

  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])

  toWarehouseId String
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])

  createdById String
  createdBy   User   @relation("TransferCreatedBy", fields: [createdById], references: [id])

  sentById String?
  sentBy   User?     @relation("TransferSentBy", fields: [sentById], references: [id])
  sentAt   DateTime?

  receivedById String?
  receivedBy   User?     @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  receivedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     TransferItem[]
  movements StockMovement[]

  @@index([status, createdAt])
  @@index([toWarehouseId, status])
  @@map("transfers")
}

model TransferItem {
  id            String   @id @default(uuid())
  quantity      Int
  serialNumbers String[]

  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@map("transfer_items")
}

enum InventoryStatus {
  IN_PROGRESS
  COUNTED
  APPROVED
  CANCELLED
}

// Инвентаризация (п.14 ТЗ). Пока подсчёт открыт (IN_PROGRESS или COUNTED), движения
// по товарам в его области на этом складе запрещены: иначе продажа во время подсчёта
// выглядела бы как недостача. В миграции: не больше одной открытой инвентаризации на склад.
model InventoryCount {
  id     String          @id @default(uuid())
  // наружу отдаётся как CNT-00001
  number Int             @unique @default(autoincrement())
  status InventoryStatus @default(IN_PROGRESS)
  notes  String?

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  // Категория, выбранная при создании (null = весь склад), и все её подкатегории на тот момент.
  categoryId       String?
  scopeCategoryIds String[]

  createdById String
  createdBy   User   @relation("CountCreatedBy", fields: [createdById], references: [id])

  finishedById String?
  finishedBy   User?     @relation("CountFinishedBy", fields: [finishedById], references: [id])
  finishedAt   DateTime?

  approvedById String?
  approvedBy   User?     @relation("CountApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines     InventoryLine[]
  serials   InventorySerial[]
  movements StockMovement[]

  @@index([warehouseId, status])
  @@map("inventory_counts")
}

// Сколько единиц товара насчитали. expectedQuantity фиксируется при утверждении.
model InventoryLine {
  id               String   @id @default(uuid())
  countedQuantity  Int      @default(0)
  expectedQuantity Int?
  updatedAt        DateTime @updatedAt

  countId String
  count   InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([countId, productId])
  @@map("inventory_lines")
}

// Отсканированные серийные номера. Уникальность в пределах подсчёта защищает от
// двойного сканирования одного экземпляра с двух телефонов одновременно.
model InventorySerial {
  id           String   @id @default(uuid())
  serialNumber String
  scannedAt    DateTime @default(now())

  countId String
  count   InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([countId, serialNumber])
  @@index([countId, productId])
  @@map("inventory_serials")
}

// --- Этап 3: заказы и резервирование ---

enum OrderStatus {
  NEW
  CONFIRMED
  PICKING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  CARD_ONLINE
  CASH_ON_DELIVERY
  BANK_TRANSFER
}

enum DeliveryMethod {
  PICKUP
  COURIER
}

enum OrderChannel {
  ONLINE
  MANUAL
}

// Заказ (п.9, п.10 ТЗ). Контакты и адрес копируются в заказ: это данные на момент
// покупки, их не должно менять последующее редактирование профиля клиента.
model Order {
  id            String        @id @default(uuid())
  // номер для людей, начинается с 100001 (см. миграцию)
  number        Int           @unique @default(autoincrement())
  status        OrderStatus   @default(NEW)
  paymentStatus PaymentStatus @default(UNPAID)
  channel       OrderChannel

  paymentMethod   PaymentMethod
  deliveryMethod  DeliveryMethod
  customerName    String
  customerPhone   String
  customerEmail   String?
  deliveryAddress String?
  comment         String?

  subtotal    Decimal @db.Decimal(12, 2)
  deliveryFee Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(12, 2)

  // Когда резерв снимется автоматически, если заказ не оплатят / не подтвердят.
  // null — резерв бессрочный (оплачен, подтверждён или создан менеджером).
  reservationExpiresAt DateTime?
  cancelReason         String?
  paidAt               DateTime?

  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  completedAt    DateTime?

  userId String?
  user   User?   @relation("OrderCustomer", fields: [userId], references: [id])

  createdById String?
  createdBy   User?   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     OrderItem[]
  events    OrderEvent[]
  movements StockMovement[]

  @@index([status, reservationExpiresAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("orders")
}

// Название, SKU, цена и НДС фиксируются на момент заказа.
model OrderItem {
  id          String  @id @default(uuid())
  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  vatPercent  Decimal @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  serialUnits  SerialUnit[]
  reservations StockReservation[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Резерв конкретного количества на конкретном складе под строку заказа.
// Активен, пока releasedAt = null. stock.reserved = сумма активных резервов.
model StockReservation {
  id             String    @id @default(uuid())
  quantity       Int
  // сколько из зарезервированного уже собрано (отсканировано) на этом складе
  pickedQuantity Int       @default(0)
  createdAt      DateTime  @default(now())
  releasedAt     DateTime?
  releaseReason  String?

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([orderItemId])
  @@index([productId, warehouseId, releasedAt])
  @@map("stock_reservations")
}

enum OrderEventType {
  CREATED
  CONFIRMED
  PAID
  CANCELLED
  EXPIRED
  PICKING_STARTED
  PICKING_COMPLETED
  SHIPPED
  DELIVERED
  COMPLETED
}

// История заказа (order_status_history в п.26 ТЗ): что произошло, когда и кто это сделал.
model OrderEvent {
  id        String         @id @default(uuid())
  type      OrderEventType
  note      String?
  createdAt DateTime       @default(now())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // null — действие системы (например, автоотмена по таймеру)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_events")
}
